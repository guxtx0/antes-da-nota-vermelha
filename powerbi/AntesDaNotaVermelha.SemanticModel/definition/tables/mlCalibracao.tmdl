				let
				    Arquivo = Parquet.Document(File.Contents(PastaDados & "\mlCalibracao.parquet")),
				    Tipos = Table.TransformColumnTypes(Arquivo, {
				        {"decimo", Int64.Type},
				        {"risco_previsto", type number},
				        {"taxa_observada", type number},
				        {"alunos", Int64.Type},
				        {"nome_do_decimo", type text}
				    })
