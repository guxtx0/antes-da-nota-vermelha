		summarizeBy: none
		sourceColumn: decisao

		annotation SummarizationSetBy = Automatic

	partition engTratamentos = m
		mode: import
		source =
				let
				    Arquivo = Parquet.Document(File.Contents(PastaDados & "\engTratamentos.parquet")),
				    Tipos = Table.TransformColumnTypes(Arquivo, {
				        {"ordem", Int64.Type},
				        {"tratamento", type text},
				        {"onde", type text},
				        {"registros", Int64.Type},
				        {"decisao", type text}
				    })
				in
				    Tipos

	annotation PBI_ResultType = Table
