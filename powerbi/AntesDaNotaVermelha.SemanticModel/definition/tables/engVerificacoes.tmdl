		annotation SummarizationSetBy = Automatic

	partition engVerificacoes = m
		mode: import
		source =
				let
				    Arquivo = Parquet.Document(File.Contents(PastaDados & "\engVerificacoes.parquet")),
				    Tipos = Table.TransformColumnTypes(Arquivo, {
				        {"ordem", Int64.Type},
				        {"grupo", type text},
				        {"verificacao", type text},
				        {"regra", type text},
				        {"observado", type number},
				        {"situacao", type text}
				    })
				in
				    Tipos

	annotation PBI_ResultType = Table
